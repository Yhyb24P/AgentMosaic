.venv/
.pytest_cache/
.mypy_cache/
__pycache__/
# Rust build output.
/target/
# Tracked documentation trees: docs/qualification/ (frozen legacy), docs/v2/
# (active Rust v2 roadmap) and docs/releases/ (public release notes). Other local
# notes under docs/ remain ignored unless governance is changed explicitly.
docs/*
!docs/qualification/
!docs/qualification/**
!docs/v2/
!docs/v2/**
!docs/releases/
!docs/releases/**
*.py[cod]
release-manifest.json
*-evidence.json
*-evidence-check.json
# Runtime state and SQLite sidecars must never enter the release baseline.
*.db
*.db-wal
*.db-shm
/backup/
/backups/
